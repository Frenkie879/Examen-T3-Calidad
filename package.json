{
  "name": "labtrack",
  "version": "2.0.0",
  "description": "LabTrack - Sistema de Gestión de Laboratorios (Calidad y Pruebas de Software, UPN)",
  "main": "src/server.js",
  "scripts": {
    "test:db": "node --test tests/unit/*.test.js",
    "start": "node src/server.js",
    "start:test": "cross-env NODE_ENV=test node src/server.js",
    "test:selenium": "mocha tests/selenium/*.test.js --timeout 60000 --reporter mocha-multi-reporters --reporter-options configFile=tests/selenium/reporters.json",
    "test:load": "node tests/load/carga_catalogo.js",
    "lint": "eslint src legacy",
    "lint:report": "eslint src legacy -f json -o reports/sonar/eslint-report.json",
    "test:selenium:visible": "cross-env HEADLESS=false npm run test:selenium",
    "test:selenium:v1": "cross-env BASE_URL=http://localhost:3001 npm run test:selenium",
    "start:v1": "cross-env PORT=3001 NODE_ENV=test node legacy/app_v1.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-session": "^1.19.0"
  },
  "devDependencies": {
    "autocannon": "^9.0.0",
    "c8": "^12.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.14.0",
    "jscpd": "^4.3.0",
    "mocha": "^10.8.2",
    "mocha-junit-reporter": "^2.2.1",
    "mocha-multi-reporters": "^1.5.2",
    "mochawesome": "^8.1.1",
    "selenium-webdriver": "4.51.0"
  }
}
